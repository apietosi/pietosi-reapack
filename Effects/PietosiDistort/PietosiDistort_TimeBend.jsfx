desc:PietosiDistort_TimeBend
// @description PietosiDistort_TimeBend - distortion by bending time: half-cycle surgery, self-Doppler, slew limiting
// @version 1.0.0
// @author pie
// @provides [effect] .

// Three stages in series, each off at its default setting.
//
// 1. Half-cycle surgery. The waveform is cut at every zero crossing (of
//    L+R, so the stereo image holds together). Each finished half-cycle is
//    rolled against the four probabilities: Reverse it, Drop it (silence),
//    Invert it, or Hold (replace it with the previous half-cycle, stretched
//    to fit). Cuts land on zero crossings, so nothing clicks. Octave Down
//    flips every other full cycle: the classic octave-fuzz trick.
//    Half-cycles longer than ~30 ms (sub-17 Hz) are left alone.
// 2. Self-Doppler. The signal sets its own delay time, so loud moments are
//    pushed later in time: phase distortion rather than clipping.
// 3. Slew limit. The output may only move so fast. A full-scale sine above
//    the Slew Limit frequency turns into a triangle; lows pass clean. Drive
//    makes it bite harder without changing the level; Asym makes rise and
//    fall different speeds (even harmonics).
//
// Latency is ~30 ms (for the half-cycle look-behind) and is reported to
// REAPER for compensation.

slider1:p_rev=0<0,100,0.1>Reverse (%)
slider2:p_drop=0<0,100,0.1>Drop (%)
slider3:p_inv=0<0,100,0.1>Invert (%)
slider4:p_hold=0<0,100,0.1>Hold (%)
slider5:oct=0<0,100,0.1>Octave Down (%)
slider6:minlen_ms=0.3<0,5,0.01>Min Half-Cycle (ms)
slider7:dop_ms=0<0,20,0.01>Doppler Depth (ms)
slider8:dop_src=0<0,2,1{Signal,Rectified,Envelope}>Doppler Source
slider9:dop_sens_db=0<-24,24,0.1>Doppler Sensitivity (dB)
slider10:dop_smooth=2000<20,20000,1:log>Doppler Smoothing (Hz)
slider11:slew_hz=20000<50,20000,1:log>Slew Limit (Hz, 20000 = off)
slider12:slew_asym=0<-100,100,0.1>Slew Asym (%)
slider13:slew_drv_db=0<0,36,0.1>Slew Drive (dB)
slider14:mix=100<0,100,0.1>Mix (%)
slider15:out_db=0<-36,12,0.1>Output (dB)

@init
R = 65536;
RB0 = 0;
RB1 = R;
DR0 = R * 2;
DR1 = R * 3;
PL = 8192;
PA0 = R * 4;
PA1 = PA0 + PL;
PB0 = PA1 + PL;
PB1 = PB0 + PL;
DS = 16384;
DB0 = PB1 + PL;
DB1 = DB0 + DS;

wp = seg_s = 0;
last_sg = 1;
cyc = 0;
plen = 0;
// prev/cur half-cycle buffers swap roles each segment
P0 = PA0; P1 = PA1; C0 = PB0; C1 = PB1;
dwp = 0;
m0 = m1 = e0 = e1 = 0;
y0 = y1 = 0;
dc_x0 = dc_y0 = dc_x1 = dc_y1 = 0;
out_s = -1;

// Rewrite one finished half-cycle [s, s+len) in the ring, in place.
function proc_seg(s, len) local(r, op, i, j, a, p, k, k2, f, g, t)
(
  i = 0;
  loop(len,
    j = (s + i) % R;
    C0[i] = RB0[j];
    C1[i] = RB1[j];
    i += 1;
  );

  r = rand(100);
  op = r < p_rev ? 1 :
       r < p_rev + p_drop ? 2 :
       r < p_rev + p_drop + p_inv ? 3 :
       r < p_rev + p_drop + p_inv + p_hold ? 4 : 0;
  op == 4 && plen < 2 ? op = 0;
  g = oct > 0 && (cyc & 1) ? 1 - 2 * oct / 100 : 1;

  op != 0 || g != 1 ? (
    i = 0;
    loop(len,
      j = (s + i) % R;
      op == 1 ? (
        a = C0[len - 1 - i]; t = C1[len - 1 - i];
      ) : op == 2 ? (
        a = t = 0;
      ) : op == 3 ? (
        a = -C0[i]; t = -C1[i];
      ) : op == 4 ? (
        p = i * (plen - 1) / max(len - 1, 1);
        k = floor(p);
        f = p - k;
        k2 = min(k + 1, plen - 1);
        a = P0[k] + (P0[k2] - P0[k]) * f;
        t = P1[k] + (P1[k2] - P1[k]) * f;
      ) : (
        a = C0[i]; t = C1[i];
      );
      RB0[j] = a * g;
      RB1[j] = t * g;
      i += 1;
    );
  );

  // The untouched input becomes "previous" for the next Hold.
  t = P0; P0 = C0; C0 = t;
  t = P1; P1 = C1; C1 = t;
  plen = len;
);

// 4-point Hermite read at fractional position pos of a ring of size n.
function herm(B, pos, n) local(i, f, xm1, x0, x1, x2, c1, c2, c3)
(
  i = floor(pos);
  f = pos - i;
  xm1 = B[(i - 1 + n) % n];
  x0 = B[i % n];
  x1 = B[(i + 1) % n];
  x2 = B[(i + 2) % n];
  c1 = 0.5 * (x1 - xm1);
  c2 = xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2;
  c3 = 0.5 * (x2 - xm1) + 1.5 * (x0 - x1);
  ((c3 * f + c2) * f + c1) * f + x0;
);

@slider
D = min(ceil(0.03 * srate), PL - 1);
pdc_delay = D;
pdc_bot_ch = 0;
pdc_top_ch = 2;
minlen = max(floor(minlen_ms * srate / 1000), 1);

dop_d = dop_ms * srate / 1000;
dop_g = 10 ^ (dop_sens_db / 20);
dop_c = exp(-2 * $pi * min(dop_smooth, srate * 0.49) / srate);
env_rel = exp(-1 / (0.05 * srate));

slew_on = slew_hz < 20000;
slew_base = 2 * $pi * slew_hz / srate;
slew_k = 2 ^ (slew_asym / 50);
slew_up = slew_base * slew_k;
slew_dn = slew_base / slew_k;
sdrv = 10 ^ (slew_drv_db / 20);

dc_c = 1 - 2 * $pi * 10 / srate;
mix_t = mix / 100;
out_t = 10 ^ (out_db / 20);
out_s < 0 ? (out_s = out_t; mix_s = mix_t);

@sample
out_s += (out_t - out_s) * 0.002;
mix_s += (mix_t - mix_s) * 0.002;

// ---- 1. half-cycle surgery (fixed look-behind of D samples)
RB0[wp] = DR0[wp] = spl0;
RB1[wp] = DR1[wp] = spl1;
sg = spl0 + spl1 >= 0;
sg != last_sg ? (
  len = (wp - seg_s + R) % R;
  len >= minlen && len <= D ? proc_seg(seg_s, len);
  sg ? cyc += 1;
  seg_s = wp;
  last_sg = sg;
);
rp = (wp - D + R) % R;
x0 = RB0[rp];
x1 = RB1[rp];
d0 = DR0[rp];
d1 = DR1[rp];
wp = (wp + 1) % R;

// ---- 2. self-Doppler
dop_d > 0 ? (
  DB0[dwp] = x0;
  DB1[dwp] = x1;
  dop_src == 0 ? (r0 = x0; r1 = x1) :
  dop_src == 1 ? (r0 = abs(x0); r1 = abs(x1)) : (
    e0 = abs(x0) > e0 ? abs(x0) : e0 * env_rel;
    e1 = abs(x1) > e1 ? abs(x1) : e1 * env_rel;
    r0 = e0; r1 = e1;
  );
  m0 = r0 + (m0 - r0) * dop_c;
  m1 = r1 + (m1 - r1) * dop_c;
  q0 = dop_d * (1 + max(min(m0 * dop_g, 1), -1)) + 2;
  q1 = dop_d * (1 + max(min(m1 * dop_g, 1), -1)) + 2;
  x0 = herm(DB0, dwp - q0 + DS, DS);
  x1 = herm(DB1, dwp - q1 + DS, DS);
  dwp = (dwp + 1) % DS;
);

// ---- 3. slew limit
slew_on ? (
  t0 = x0 * sdrv - y0;
  t1 = x1 * sdrv - y1;
  y0 += max(min(t0, slew_up), -slew_dn);
  y1 += max(min(t1, slew_up), -slew_dn);
  x0 = y0 / sdrv;
  x1 = y1 / sdrv;
);

// DC blocker (asymmetric slew and rectified Doppler can shift the centre)
dc_y0 = x0 - dc_x0 + dc_c * dc_y0; dc_x0 = x0; x0 = dc_y0;
dc_y1 = x1 - dc_x1 + dc_c * dc_y1; dc_x1 = x1; x1 = dc_y1;

spl0 = (d0 + (x0 - d0) * mix_s) * out_s;
spl1 = (d1 + (x1 - d1) * mix_s) * out_s;
