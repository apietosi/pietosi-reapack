desc:PietosiDistort_Polar
// @description PietosiDistort_Polar - distorts a signal's envelope and phase separately
// @version 1.0.0
// @author pie
// @provides [effect] .

// A Hilbert transform (two allpass chains 90 degrees apart) splits the
// signal into its envelope (how loud, right now) and its phase (where in
// the cycle, right now). Each half is mangled on its own, then the two are
// put back together as envelope * cos(phase).
//
// Envelope side: dynamics change, timbre stays.
//   Ceiling/Drive  soft-clip the envelope: a limiter with no attack time
//                  (linear below half the ceiling; +6 dB default = off)
//   Flatten        100% throws the envelope away: pure-phase fuzz
//   Env Steps      quantize loudness in dB steps: stepped, gated tremolo
// Phase side: timbre changes, dynamics stay.
//   Multiply       scales the phase: 2 = octave up, 0.5 = down, fractions
//                  give inharmonic, bell-like shifts
//   Phase Steps    quantize the cycle into N positions: staircase waves
//   Phase Hold     sample-and-hold the phase: aliased, decimated grit
//   Jitter         random phase noise: raspy, breathy
// Below Floor the signal passes clean, so silence stays silent.
// Zero latency (the allpass chains add phase shift, not delay).

slider1:env_drv_db=0<0,36,0.1>Env Drive (dB)
slider2:env_ceil_db=6<-60,6,0.1>Env Ceiling (dB)
slider3:flat=0<0,100,0.1>Flatten (%)
slider4:env_step=0<0,24,0.1>Env Steps (dB, 0 = off)
slider5:pmul=1<0.25,8,0.01>Phase Multiply
slider6:psteps=0<0,64,1>Phase Steps (0 = off)
slider7:phold=1<1,64,1>Phase Hold (samples)
slider8:jit_deg=0<0,180,0.1>Phase Jitter (deg)
slider9:floor_db=-70<-100,-20,0.1>Floor (dB)
slider10:tone=20000<200,20000,1:log>Tone (Hz)
slider11:mix=100<0,100,0.1>Mix (%)
slider12:out_db=0<-36,24,0.1>Output (dB)

@init
// Allpass coefficients (Olli Niemitalo's 90-degree network), stored squared.
CA = 0; CB = 4;
CA[0] = 0.6923878 ^ 2;       CA[1] = 0.9360654322959 ^ 2;
CA[2] = 0.9882295226860 ^ 2; CA[3] = 0.9987488452737 ^ 2;
CB[0] = 0.4021921162426 ^ 2; CB[1] = 0.8561710882420 ^ 2;
CB[2] = 0.9722909545651 ^ 2; CB[3] = 0.9952884791278 ^ 2;
// Filter state: 16 values per (channel, chain).
SA0 = 16; SB0 = 32; SA1 = 48; SB1 = 64;
memset(16, 0, 64);
da0 = da1 = 0;
acc0 = acc1 = pv0 = pv1 = 0;
hc = 0; hp0 = hp1 = 0;
gs = 0;
lp0 = lp1 = 0;
TWO_PI = 2 * $pi;
out_s = -1;

// Four cascaded 2nd-order allpasses: y = a^2 * (x + y[n-2]) - x[n-2].
function chain(st, cf, x) local(i, y)
(
  i = 0;
  loop(4,
    y = cf[i] * (x + st[4 * i + 3]) - st[4 * i + 1];
    st[4 * i + 1] = st[4 * i];
    st[4 * i] = x;
    st[4 * i + 3] = st[4 * i + 2];
    st[4 * i + 2] = y;
    x = y;
    i += 1;
  );
  x;
);

// JSFX has no built-in tanh.
function th(u) local(e)
(
  e = exp(2 * min(max(u, -20), 20));
  (e - 1) / (e + 1);
);

function wrap(p)
(
  p - TWO_PI * floor((p + $pi) / TWO_PI);
);

// Linear up to half the ceiling, then a tanh knee that never passes it.
function shape_env(a) local(x, k)
(
  x = a * env_drv;
  k = env_c * 0.5;
  x > k ? x = k + (env_c - k) * th((x - k) / (env_c - k));
  flat > 0 && x > 0 ? x = env_c * (x / env_c) ^ (1 - flat / 100);
  env_step > 0 && x > 0 ? x = 10 ^ (floor(20 * log10(x) / env_step + 0.5) * env_step / 20);
  x;
);

@slider
env_drv = 10 ^ (env_drv_db / 20);
env_c = 10 ^ (env_ceil_db / 20);
pq = psteps > 0 ? TWO_PI / psteps : 0;
jit = jit_deg * $pi / 180;
floor_lin = 10 ^ (floor_db / 20);
lp_c = exp(-2 * $pi * min(tone, srate * 0.49) / srate);
gat_c = 1 - exp(-1 / (0.005 * srate));
mix_t = mix / 100;
out_t = 10 ^ (out_db / 20);
out_s < 0 ? (out_s = out_t; mix_s = mix_t);

@sample
out_s += (out_t - out_s) * 0.002;
mix_s += (mix_t - mix_s) * 0.002;

// Analytic signal: I = chain A delayed one sample, Q = chain B.
i0 = da0; da0 = chain(SA0, CA, spl0); q0 = chain(SB0, CB, spl0);
i1 = da1; da1 = chain(SA1, CA, spl1); q1 = chain(SB1, CB, spl1);

a0 = sqrt(i0 * i0 + q0 * q0);
a1 = sqrt(i1 * i1 + q1 * q1);
p0 = atan2(q0, i0);
p1 = atan2(q1, i1);

// Unwrapped phase, scaled by Multiply, kept bounded.
acc0 = wrap(acc0 + wrap(p0 - pv0) * pmul); pv0 = p0;
acc1 = wrap(acc1 + wrap(p1 - pv1) * pmul); pv1 = p1;
pmul == 1 ? (acc0 = p0; acc1 = p1);

// Phase sample-and-hold.
hc += 1;
hc >= phold ? (hc = 0; hp0 = acc0; hp1 = acc1);
f0 = phold > 1 ? hp0 : acc0;
f1 = phold > 1 ? hp1 : acc1;

jit > 0 ? (f0 += (rand(2) - 1) * jit; f1 += (rand(2) - 1) * jit);
pq > 0 ? (f0 = floor(f0 / pq + 0.5) * pq; f1 = floor(f1 / pq + 0.5) * pq);

w0 = shape_env(a0) * cos(f0);
w1 = shape_env(a1) * cos(f1);

// Gate: below Floor, fall back to the clean (allpassed) signal.
gs += ((max(a0, a1) > floor_lin) - gs) * gat_c;
w0 = i0 + (w0 - i0) * gs;
w1 = i1 + (w1 - i1) * gs;

tone < 20000 ? (
  w0 = lp0 = w0 + (lp0 - w0) * lp_c;
  w1 = lp1 = w1 + (lp1 - w1) * lp_c;
);

// Dry reference is I (same allpass phase as the wet path) so Mix never combs.
spl0 = (i0 + (w0 - i0) * mix_s) * out_s;
spl1 = (i1 + (w1 - i1) * mix_s) * out_s;
